# SubSense Configuration

# Server port (default: 3100)
PORT=3100

# Public Base URL for the addon (used for subtitle proxy URLs sent to Stremio)
# - For local: leave commented out (will default to http://127.0.0.1:PORT)
# - For production: set to your public URL (e.g., https://subsense.yourdomain.com)
SUBSENSE_BASE_URL=https://subsense.yourdomain.com

# Bind address. Use 0.0.0.0 inside a container (default: 127.0.0.1)
# HOST=0.0.0.0

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Encryption key for securing provider API keys in manifest URLs
SUBSENSE_ENCRYPTION_KEY=any-secure-passphrase

# ============================================
# Provider Configuration
# ============================================

# SUBTITLE_SOURCES: Which providers to enable (comma-separated)
# Available providers: wyzie, betaseries, yify, tvsubtitles, subsource, subdl, animetosho, opensubtitles, gestdown
# - wyzie: Aggregates multiple sources (OpenSubtitles, Subf2m, Kitsunekko, etc.)
# - betaseries: Good for French subtitles (requires BETASERIES_API_KEY)
# - yify: Movie subtitles from YIFY/YTS
# - tvsubtitles: TV series subtitles from TVsubtitles.net
# - subsource: SubSource provider (requires API key per request)
# - subdl: SubDL provider (requires API key per request, get one at https://subdl.com)
# - animetosho: Anime subtitles from AnimeTosho.org (requires ANIDB_CLIENT for TV episodes)
# - opensubtitles: Direct OpenSubtitles Legacy API (movies + TV, no API key required)
# - gestdown: Gestdown API for TV subtitles (requires TVDB_API_KEY OR TMDB_API_KEY)
# Default (if not set): ALL providers are enabled
# SUBTITLE_SOURCES=wyzie,betaseries,yify,tvsubtitles,subsource,subdl,animetosho,opensubtitles,gestdown

# WYZIE_SOURCES: Override which sources Wyzie should query (comma-separated)
# By default, sources are fetched dynamically from the Wyzie API every 24 hours.
# Set this to override with a fixed list (e.g., to exclude certain sources).
# Available (check https://sub.wyzie.io/sources): Subf2m, OpenSubtitles, Kitsunekko, Gestdown, YIFY, TVsubtitles
# WYZIE_SOURCES=Subf2m,OpenSubtitles,Kitsunekko,Gestdown,YIFY,TVsubtitles

# REQUIRED for Wyzie to work - API key(s) for Wyzie Subs (free at https://sub.wyzie.io/redeem)
# Supports comma-separated values for key pool rotation
# WYZIE_API_KEYS=wyzie-your-key-here
# WYZIE_API_KEYS=wyzie-key-1,wyzie-key-2,wyzie-key-3

# ============================================
# BetaSeries API (Optional) - French/English provider
# ============================================
# Get your API key at: https://www.betaseries.com/api/
# BETASERIES_API_KEY=your_api_key_here

# ============================================
# Cluster
# ============================================

# Request workers to fork. "auto" uses CPU count minus one. Production runs 3.
# The primary opens no databases and serves no traffic; it only forks and supervises.
# WEB_CONCURRENCY=3

# Heap cap. This applies to EACH worker process, not to the group, so a value sized
# for a single process now multiplies by WEB_CONCURRENCY.
# NODE_OPTIONS=--max-old-space-size=768

# Delay before the primary replaces a worker that died, in ms (default: 1000)
# REFORK_DELAY_MS=1000

# Force-exit deadline after SIGTERM, in ms (default: 10000)
# SHUTDOWN_TIMEOUT_MS=10000

# ============================================
# Redis - hot cache and delta buffer
# ============================================

# Redis holds built responses and buffered analytics. It is never a source of truth:
# if it is unreachable the addon keeps serving from SQLite, without analytics.
# REDIS_URL=redis://subsense-redis:6379

# Response cache TTL in hours (default: 6)
# L1_TTL_HOURS=6

# Age at which a cached response is still served but refreshed in the background (default: 2)
# L1_STALE_AFTER_HOURS=2

# Per-command timeout in ms (default: 250). Commands fail fast so callers can fall back
# to SQLite rather than waiting on a struggling Redis.
# REDIS_COMMAND_TIMEOUT_MS=250

# ============================================
# Storage - three files, separate lock domains
# ============================================

# Directory holding the database files (default: ./data)
# DB_DIR=./data

# Individual paths, if you want them somewhere other than DB_DIR
# CACHE_DB_PATH=./data/subsense-cache.db
# STATS_DB_PATH=./data/subsense-stats.db
# META_DB_PATH=./data/subsense-meta.db

# Subtitle cache retention in days (default: 7). This is the real retention knob;
# the old CACHE_RETENTION_DAYS was documented for a long time but never read by any code.
# L2_TTL_DAYS=7

# Provider metadata cache retention in days (default: 30 each)
# META_TTL_ANIDB_DAYS=30
# META_TTL_AT_DAYS=30

# Byte cap on the in-memory subtitle body cache (default: 268435456 = 256 MB).
# These are Buffers, so they live outside the Node heap limit above.
# PROXY_CACHE_MAX_BYTES=268435456
# PROXY_CACHE_TTL_HOURS=24

# ============================================
# Statistics
# ============================================

# STATS_REFRESH_INTERVAL was REMOVED in v2.4.0. It existed because full stats mode was
# expensive enough to threaten the process. Recording is now a buffered counter flushed to
# Redis and folded by the maintenance worker, so there is nothing left to throttle.
# There is one mode, and /stats is available to everyone.

# Set to false to switch off all recording (default: true).
# Note this also removes the active and total user counts from the /configure page,
# because /api/config only returns them while recording is on.
# STATS_ENABLED=false

# How often buffered counters are pipelined to Redis, in ms (default: 5000)
# TRACK_FLUSH_MS=5000

# Content-log queue depth at which new rows are shed (default: 50000)
# CL_QUEUE_MAX=50000

# ============================================
# Health thresholds
# ============================================
# /health is cheap, does no I/O, and drives the container healthcheck.
# /health/deep checks every dependency and answers 503 when degraded. Never point a
# container healthcheck at it: a restart cannot fix an upstream outage.

# Worker heartbeat age in seconds before /health/deep reports worker-heartbeat (default: 300)
# HEALTH_HEARTBEAT_MAX_SECONDS=300

# Fold age in seconds before /health/deep reports fold-stale (default: 300)
# HEALTH_FOLD_MAX_SECONDS=300

# Content-log queue depth before /health/deep reports queue-depth (default: 80% of CL_QUEUE_MAX)
# HEALTH_QUEUE_MAX=40000

# Per-file budget for the SQLite probe, in ms (default: 2000)
# HEALTH_DB_TIMEOUT_MS=2000

# ============================================
# Maintenance worker
# ============================================
# The worker is the only process that writes to the databases on a schedule.
# Every job runs under a time budget and reports what it left behind.

# WORKER_DRAIN_INTERVAL_MS=10000        # content-log drain
# WORKER_FOLD_INTERVAL_MS=60000         # analytics fold
# WORKER_USERS_INTERVAL_MS=60000        # user counter flush
# WORKER_CLEANUP_INTERVAL_MS=7200000    # L2 cache retention
# WORKER_CHECKPOINT_INTERVAL_MS=1800000 # WAL checkpoint
# WORKER_PRUNE_USERS_INTERVAL_MS=21600000
# WORKER_PRUNE_META_INTERVAL_MS=86400000
# WORKER_HEALTH_INTERVAL_MS=60000       # heartbeat and health snapshot
# WORKER_SHUTDOWN_TIMEOUT_MS=15000

# ============================================
# AnimeTosho Provider Configuration (Optional)
# ============================================

# AniDB HTTP API credentials — required for AnimeTosho TV episode search.
# Register your own client at: https://anidb.net/software/add
# Without these, AnimeTosho will only serve anime MOVIES (via AniDB anime ID).
# TV episode search requires AniDB to resolve episode IDs (eids).
# ANIDB_CLIENT=your_client_name
# ANIDB_CLIENT_VER=1

# Max torrent entries to inspect per search (default: 6)
# ANIMETOSHO_SEARCH_THRESHOLD=6

# Fribb anime-lists refresh interval in hours (default: 24)
# ANIME_LISTS_REFRESH_HOURS=24

# ============================================
# TMDB/TVDB API for Gestdown Provider (Optional) - TV only
# ============================================

# TVDB API key - get one at: https://thetvdb.com/api-information
# TVDB_API_KEY=your-tvdb-api-key-here

# TMDB API key - get one at: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your-tmdb-api-key-here

# ============================================
# WARP Proxy Configuration (Optional)
# ============================================
# WARP runs in proxy mode: only traffic routed through the SOCKS5 port goes through Cloudflare

# Enable WARP (set in docker-compose, requires NET_ADMIN + /dev/net/tun)
# WARP_ENABLED=true

# WARP SOCKS5 proxy URL (auto-set by entrypoint.sh when WARP is enabled)
# WARP_PROXY_URL=socks5h://127.0.0.1:40000

# WARP proxy port (default: 40000)
# WARP_PORT=40000

# Domains to route through WARP proxy (comma-separated)
# WARP_DOMAINS=

# WARP license key for WARP+ (optional)
# WARP_LICENSE_KEY=

# WARP IP rotation
# Minimum gap between two rotations, cluster-wide (default: 30000)
# WARP_ROTATION_COOLDOWN_MS=30000

# Attempts to get a different exit IP before giving up (default: 3)
# WARP_ROTATION_MAX_ATTEMPTS=3

# How long a rotation waits for in-flight WARP requests to finish (default: 3000)
# WARP_DRAIN_TIMEOUT_MS=3000

# How long a request waits at a closed gate before going ahead anyway (default: 15000)
# WARP_GATE_TIMEOUT_MS=15000

# How long a worker waits for the primary's rotation reply (default: 60000)
# WARP_ROTATE_REPLY_TIMEOUT_MS=60000
